# MedGuardian backend environment variables.
# Copy this file to .env and fill in real values. .env is gitignored.

# Sarvam AI key for TTS / STT (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase project URL and browser-safe publishable/anon key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# Backend-only Supabase secret/service-role key. Never expose to the frontend.
SUPABASE_SECRET_KEY=

# ----- OpenRouter (cloud LLM + vision OCR — Agents 1, 3, 5) -----
# Shared OpenRouter API key. Agent 1 (OCR), Agent 3 (teach-back), and Agent 5
# (claim) all route through OpenRouter (OpenAI-compatible) so the backend deploys
# to Vercel/cloud with no localhost dependency. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
# Vision model used by Agent 1 for discharge-summary OCR. Default is the modern
# successor to google/gemini-1.5-flash (now retired). If the model is unavailable
# or rate limited, /api/upload returns a labelled 503 ("OCR Extraction failed
# via OpenRouter.").
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Cumulative deadline (seconds) allowed for one OCR extraction across the
# primary model + fallbacks.
OCR_TIMEOUT_SECONDS=180

# URL-safe base64 or 64-character hex encoding of a randomly generated 32-byte key.
MEDGUARDIAN_TOKEN_ENCRYPTION_KEY=

# ----- Google Calendar OAuth (backend-only; never exposed to the frontend) -----
# Create these in Google Cloud Console > APIs & Services > Credentials >
# OAuth client (Web application). Add GOOGLE_REDIRECT_URI to the authorized
# redirect URIs. Enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
# Comma-separated list of frontend origins the OAuth callback may redirect to.
FRONTEND_REDIRECT_ORIGINS=http://localhost:3000
# Default IANA timezone for medication reminder events.
DEFAULT_TIMEZONE=Asia/Kolkata

# ----- Admin authorization (server-resolved, never client-supplied) -----
# Comma-separated allowlist of Supabase Auth emails permitted to access the
# admin patient registry (GET /api/patients). The SERVER resolves admin status
# from the validated Supabase user's email against this list and returns it in
# the auth response role field. A patient who selects the "admin" toggle on the
# login page but is NOT on this list is always treated as a patient. Empty by
# default → no one is an admin until an operator configures it.
ADMIN_EMAILS=
