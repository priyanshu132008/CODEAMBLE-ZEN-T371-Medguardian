# MedGuardian backend environment variables.
# Copy this file to .env and fill in real values. .env is gitignored.

# Sarvam AI key for TTS / STT (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase project URL and browser-safe publishable/anon key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Comma-separated endpoints explicitly approved for raw local document inference.
# Raw PDFs/images are rejected unless the active endpoint appears here.
MEDGUARDIAN_LOCAL_AI_ENDPOINTS=
