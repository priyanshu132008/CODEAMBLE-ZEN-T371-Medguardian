# Public Supabase browser credentials for the "Continue with Google" sign-in
# flow. These are the SAME RLS-protected public values the backend exposes —
# safe to ship to the browser (they are the anon/publishable key, not the
# service-role secret). Copy them from backend/.env:
#   NEXT_PUBLIC_SUPABASE_URL      <- backend SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY <- backend SUPABASE_PUBLISHABLE_KEY
#
# In a real deployment these come from your hosting provider's environment
# variables (Vercel/Netlify), NOT from a committed file. .env.local is
# gitignored and never committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=