# Public Supabase browser credentials for the "Continue with Google" sign-in
# flow. These are the SAME RLS-protected public values the backend exposes —
# safe to ship to the browser (they are the anon/publishable key, not the
# service-role secret). Copy them from backend/.env:
#   NEXT_PUBLIC_SUPABASE_URL      <- backend SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY <- backend SUPABASE_PUBLISHABLE_KEY
#
# In a real deployment these come from your hosting provider's environment
# variables (Vercel/Netlify), NOT from a committed file. .env.local is
# gitignored and never committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API origin the frontend talks to. In dev this is the local FastAPI
# server; in production (and for real mobile devices, which cannot reach your
# dev machine's localhost) set this to the deployed backend origin, e.g.
# https://medguardian-api.up.railway.app. A trailing slash is tolerated. The
# frontend appends `/api` itself, so do NOT include `/api` here. If unset, the
# frontend falls back to http://localhost:8000 (dev only — will fail on mobile
# and in production with ERR_CONNECTION_REFUSED).
NEXT_PUBLIC_API_BASE_URL=